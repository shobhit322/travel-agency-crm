# Environment variables for the Vercel project (Settings > Environment Variables).
# This file is a checklist only: never put real values here and never commit them.
# `.env*` files are excluded from the image; Vercel injects these at runtime.

# --- Application ---------------------------------------------------------------
APP_NAME="VI Studio Travel CRM"
# Generate once without PHP:  echo "base64:$(openssl rand -base64 32)"   Keep it stable forever.
APP_KEY=
# The platform domain. Super Admin lives at https://<this>/admin; each agency at https://<slug>.<this>/tenant
APP_URL=https://example.com
# Same host as APP_URL, no scheme. Agencies are served at {slug}.{APP_PUBLIC_DOMAIN}, so the Vercel
# project needs BOTH example.com and the wildcard *.example.com (wildcard needs Vercel nameservers
# or the _acme-challenge NS delegation described in Vercel's domain docs).
APP_PUBLIC_DOMAIN=example.com
# Leave SESSION_DOMAIN unset: per-agency cookies are what isolate agency sessions.
SESSION_DOMAIN=

# --- Database (managed PostgreSQL, e.g. Neon via the Vercel Marketplace) ---------
DB_CONNECTION=pgsql
# Simplest: one connection string (Laravel reads DB_URL and it overrides the DB_HOST... values below), e.g.
# the Neon connection string ending in ?sslmode=require. Otherwise fill in the individual values.
DB_URL=
# Neon: use the DIRECT host for the GitHub "Vercel database" migrations, and either host for the app.
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

# --- Sessions, cache, queue ------------------------------------------------------
# Already the image defaults; listed so they are never overridden by mistake.
SESSION_DRIVER=database
CACHE_STORE=database
# "sync": no worker process can run on Vercel. Only password-reset mail and email campaigns are queued,
# and with "sync" they run inside the request or cron call that triggers them.
QUEUE_CONNECTION=sync

# --- File storage (S3-compatible, e.g. Cloudflare R2 / Backblaze B2 / AWS S3) ----
OBJECT_STORAGE=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
# Private bucket: passports and booking documents. Never make this public.
AWS_PRIVATE_BUCKET=
# Public bucket: agency logos, favicons and avatars, served from AWS_PUBLIC_URL.
AWS_PUBLIC_BUCKET=
AWS_PUBLIC_URL=
# CORS is needed on the PRIVATE bucket only: Livewire uploads straight from the browser to it with a
# presigned PUT. Allow PUT (and the headers the browser sends) from https://*.<your domain>, and expose ETag.
# Livewire stores its temporary uploads on the default disk (FILESYSTEM_DISK, "local" in the image),
# which is the private bucket here, so no extra Livewire setting is needed.
# Livewire's temporary uploads (livewire-tmp/) are not deleted automatically on S3. Add a bucket
# lifecycle rule that expires the "livewire-tmp/" prefix after 1 day.

# --- Scheduled work (Vercel Cron -> /internal/cron/*) ----------------------------
# 16+ random characters. Vercel sends it as "Authorization: Bearer <value>". Unset = endpoint disabled.
CRON_SECRET=

# --- Mail ------------------------------------------------------------------------
# Tenants and the platform store their own SMTP settings in the app; this is only the fallback.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# --- First-time bootstrap only (GitHub Action "Vercel database") -----------------
# Set as GitHub Actions secrets, NOT in Vercel. See ProductionSeeder.
# PLATFORM_ADMIN_EMAIL=
# PLATFORM_ADMIN_PASSWORD=   (12+ characters)
